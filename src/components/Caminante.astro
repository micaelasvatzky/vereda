---
import { ARTICULACIONES as rig, CAMINANTE } from '../config.js';

// Rodillas y codos son hijos de su pierna/brazo: heredan el giro del padre.
const piernas = [
  { lado: 'Lejana', recorte: 'piernaLejana', mitad: rig.pivotes.rodillaLejana[1] },
  { lado: 'Cercana', recorte: 'piernaCercana', mitad: rig.pivotes.rodillaCercana[1] },
];
const brazos = [
  { lado: 'Lejano', recorte: 'brazoLejano', mitad: rig.pivotes.codoLejano[1] },
  { lado: 'Cercano', recorte: 'brazoCercano', mitad: rig.pivotes.codoCercano[1] },
];
---

<div class="caminante" data-caminante data-caminando="false"
  data-direccion="derecha" data-mirando="false"
  style={`--alto-caminante:${CAMINANTE.alto}px;`} aria-hidden="true">
  <svg class="caminante__figura" viewBox={`0 0 ${rig.ancho} ${rig.alto}`} focusable="false">
    <defs>
      <image id="chica-dibujo" href={rig.base} width={rig.ancho} height={rig.alto} />
      <image id="chica-imagen-mirada" href={rig.cabezaMirando} width={rig.ancho} height={rig.alto} />
      {Object.entries(rig.recortes).map(([nombre, d]) => (
        <clipPath id={`chica-${nombre}`}><path d={d} /></clipPath>
      ))}
      {[...piernas, ...brazos].map(({ recorte, mitad }) => (
        <>
          <clipPath id={`chica-${recorte}-arriba`}>
            <rect x="0" y="0" width={rig.ancho} height={mitad + rig.solape} />
          </clipPath>
          <clipPath id={`chica-${recorte}-abajo`}>
            <rect x="0" y={mitad - rig.solape} width={rig.ancho} height={rig.alto} />
          </clipPath>
        </>
      ))}
      {piernas.map(({ lado, recorte, mitad }) => (
        <clipPath id={`chica-${recorte}-union`}>
          <circle cx={rig.pivotes[`rodilla${lado}`][0]} cy={mitad} r={rig.radioRodilla} />
        </clipPath>
      ))}
    </defs>
    <g data-cuerpo>
      {piernas.map(({ lado, recorte, mitad }) => (
        <g data-articulacion={`cadera${lado}`}>
          {lado === 'Cercana' && <path d={rig.caderaOculta} fill={rig.colorJean} />}
          <g clip-path={`url(#chica-${recorte}-arriba)`}>
            <use href="#chica-dibujo" clip-path={`url(#chica-${recorte})`} />
          </g>
          <use href="#chica-dibujo" clip-path={`url(#chica-${recorte}-union)`} />
          <g data-articulacion={`rodilla${lado}`}>
            <g clip-path={`url(#chica-${recorte}-abajo)`}>
              <use href="#chica-dibujo" clip-path={`url(#chica-${recorte})`} />
            </g>
          </g>
        </g>
      ))}
      <g data-articulacion="hombroLejano">
        <g clip-path="url(#chica-brazoLejano-arriba)">
          <use href="#chica-dibujo" clip-path="url(#chica-brazoLejano)" />
        </g>
        <g data-articulacion="codoLejano">
          <g clip-path="url(#chica-brazoLejano-abajo)">
            <use href="#chica-dibujo" clip-path="url(#chica-brazoLejano)" />
          </g>
        </g>
      </g>
      <!-- Completa el abrigo que estaba oculto por el brazo original. -->
      <path d={rig.abrigoOculto}
        fill={rig.colorAbrigo} stroke={rig.bordeAbrigo} stroke-width="1.5" />
      <use href="#chica-dibujo" clip-path="url(#chica-torso)" />
      <g data-articulacion="hombroCercano">
        <g clip-path="url(#chica-brazoCercano-arriba)">
          <use href="#chica-dibujo" clip-path="url(#chica-brazoCercano)" />
        </g>
        <g data-articulacion="codoCercano">
          <g clip-path="url(#chica-brazoCercano-abajo)">
            <use href="#chica-dibujo" clip-path="url(#chica-brazoCercano)" />
          </g>
        </g>
      </g>
      <g class="caminante__cabeza caminante__cabeza--frente">
        <use href="#chica-dibujo" clip-path="url(#chica-cabeza)" />
      </g>
      <g class="caminante__cabeza caminante__cabeza--cartel" transform={rig.ajusteMirada}>
        <use href="#chica-imagen-mirada" clip-path="url(#chica-mirada)" />
      </g>
    </g>
  </svg>
</div>

<style>
  .caminante {
    position: absolute;
    left: 0;
    bottom: calc((1 - var(--caminante-y, 0.9)) * 100%);
    height: calc(var(--alto-caminante, 380px) * var(--escala, 1));
    aspect-ratio: 209.25 / 511.5;
    transform: translate3d(calc(var(--caminante-x, 0.24) * 100vw - 50%), 0, 0)
      scaleX(var(--orientacion, 1));
    will-change: transform;
    pointer-events: none;
    z-index: 2;
  }
  .caminante[data-direccion='izquierda'] { --orientacion: -1; }
  .caminante__figura { display: block; width: 100%; height: 100%; overflow: visible; }
  /* Sólo cambia la cabeza; el cuerpo sigue caminando. Sin fundir siluetas. */
  .caminante__cabeza--cartel { visibility: hidden; }
  .caminante[data-mirando='true'] .caminante__cabeza--frente { visibility: hidden; }
  .caminante[data-mirando='true'] .caminante__cabeza--cartel { visibility: visible; }
</style>
