---
/*
 * Cartelera — placeholder de la Fase 1.
 *
 * En esta fase sólo está el marco verde y el afiche negro, para poder medir
 * el motor del escenario (dónde caen, cuál queda activa). El contenido real,
 * el `<dialog>` y el afiche tipográfico entran en la Fase 2.
 *
 * PLACEHOLDER Fase 1: el marco verde es un rectángulo con sombra, NO la forma
 * del cartel icónico de Buenos Aires. Falta la foto de referencia de Mica.
 */

interface Props {
  indice: number;
}

const { indice } = Astro.props;
---

<article
  class="cartelera"
  data-cartelera
  data-indice={indice}
  data-activa="false"
  style={`--indice: ${indice};`}
>
  <div class="cartelera__marco">
    <div class="cartelera__afiche">
      <span class="todo-mica">TODO(Mica): #{indice + 1}</span>
    </div>
  </div>
  <div class="cartelera__poste" aria-hidden="true"></div>
</article>

<style>
  .cartelera {
    position: absolute;
    /*
     * La base se planta en la MISMA línea de suelo que la chica
     * (CAMINANTE.y, publicada como --caminante-y): el pie del poste queda
     * parado sobre la baldosa donde camina ella, no colgado en el borde
     * inferior de la pantalla.
     * Los números de posición salen de config.js vía escenario.js. Los
     * valores de respaldo son sólo para que el recuadro siga siendo
     * razonable antes de que corra el script.
     */
    bottom: calc((1 - var(--caminante-y, 0.82)) * 100%);
    left: calc(
      (var(--cartelera-margen, 1000) + var(--indice) * var(--cartelera-separacion, 1400)) *
        var(--escala, 1)
    );
    width: calc(var(--cartelera-ancho, 520) * var(--escala, 1));
    display: flex;
    flex-direction: column;
    align-items: center;
    transition:
      opacity var(--duracion-aparecer, 0.6s) var(--curva-aparecer, ease-out),
      transform var(--duracion-aparecer, 0.6s) var(--curva-aparecer, ease-out);
  }

  /*
   * La cartelera se aparece: mientras no la "desoculte" el motor
   * (escenario.js, método revelar), está escondida y un toque más abajo.
   * El pointer-events: none es necesario: sin él, el hover del marco verde
   * escondido cambiaría la pose de la chica a "mira" hacia un cartel que
   * no se ve.
   * El selector exige data-motor="riel": si no hay JavaScript, las
   * carteleras se muestran todas (fallback al final del bloque).
   */
  html[data-motor='riel'] .cartelera:not([data-visible='true']) {
    opacity: 0;
    transform: translateY(24px);
    pointer-events: none;
  }

  /* Sin JavaScript las carteleras dejan de estar posicionadas en el mundo. */
  html:not([data-motor='riel']) .cartelera {
    position: static;
    width: min(320px, 78vw);
  }

  .cartelera__marco {
    width: 100%;
    aspect-ratio: 4 / 5;
    background: var(--verde-cartelera);
    border: 6px solid var(--verde-cartelera-oscuro);
    border-radius: 10px;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.35);
    padding: 22px;
    transition:
      transform var(--duracion-prendido) var(--curva-prendido),
      box-shadow var(--duracion-prendido) var(--curva-prendido);
  }

  .cartelera__afiche {
    width: 100%;
    height: 100%;
    background: var(--afiche-fondo);
    color: var(--afiche-texto);
    display: grid;
    place-items: center;
    padding: 1rem;
    text-align: center;
  }

  .cartelera__poste {
    width: 14px;
    height: calc(180 * var(--escala));
    background: var(--verde-cartelera-oscuro);
  }

  /* La cartelera activa se "prende": crece apenas y levanta sombra. */
  .cartelera[data-activa='true'] .cartelera__marco {
    transform: scale(1.04) translateY(-10px);
    box-shadow:
      0 24px 60px rgb(0 0 0 / 0.5),
      0 0 0 8px rgb(255 255 255 / 0.12);
  }

  /*
   * Menos movimiento: la cartelera aparece igual (el motor sigue marcando
   * data-visible), pero sin fundido ni desplazamiento.
   */
  @media (prefers-reduced-motion: reduce) {
    html[data-motor='riel'] .cartelera {
      transition: none;
    }
  }
</style>