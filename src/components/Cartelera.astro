---
/*
 * Cartelera — un cartel de la vereda con la preview de un proyecto.
 *
 * El cartel ES el SVG que dibujó Mica (/img/CartelVerde.svg): marco,
 * afiche y poste vienen de una sola pieza en su dibujo, así que ya no hay
 * poste de CSS ni rectángulo verde pintado a mano.
 *
 * FASE 2 — la preview va en el HUECO TRANSPARENTE del marco (Mica: "las
 * previews van en el hueco transparente de la imagen, como si fueran el
 * cartel"). Ese hueco es un rectángulo dentro del marco verde, medido
 * sobre el render del SVG actual (viewBox 8606 × 13382):
 *
 *   hueco:  x 590..7996   y 2580..8011
 *           left 6.86%   top 19.28%   width 86.05%   height 40.58%
 *
 * OJO: el rectángulo NEGRO de arriba (x 3504..5158, y 268..2490) NO es el
 * hueco: es opaco, es la ilustración de Mica. Por eso la preview no va
 * ahí. Las medidas se sacaron de pixels, no a ojo: se renderizó el SVG
 * con fondo transparente y se buscó el componente transparente cerrado
 * más grande (ver docs/bitacora.md).
 *
 * Sobre la preview van dos links que NO se anidan (HTML no permite un
 * <a> dentro de otro <a>):
 *   - la imagen va a Vercel (el link principal, cubre toda la preview);
 *   - el botón de GitHub va a GitHub, arriba de todo con z-index.
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { RUTAS_CARTEL, CARTEL } from '../config.js';

interface DatosProyecto {
  titulo: string;
  vercel: string;
  github: string;
  preview: ImageMetadata;
}

interface Props {
  indice: number;
  proyecto?: { data: DatosProyecto };
}

const { indice, proyecto } = Astro.props;
---

<article
  class="cartelera"
  data-cartelera
  data-indice={indice}
  data-activa="false"
  style={`--indice: ${indice};`}
>
  <div
    class="cartelera__cartel"
    style={`--hueco-left:${CARTEL.hueco.left}%; --hueco-top:${CARTEL.hueco.top}%; --hueco-width:${CARTEL.hueco.width}%; --hueco-height:${CARTEL.hueco.height}%;`}
  >
    <img
      class="cartelera__arte"
      src={RUTAS_CARTEL.verde}
      alt=""
      aria-hidden="true"
      decoding="async"
    />
    {
      proyecto && (
        <div class="cartelera__preview">
          <Image
            class="cartelera__preview-img"
            src={proyecto.data.preview}
            alt={`Captura de ${proyecto.data.titulo}`}
            widths={[320, 640, 960]}
            sizes="(max-width: 768px) 40vw, 380px"
            loading="eager"
            decoding="async"
          />
          {/* Link principal: la preview entera lleva a Vercel. */}
          <a
            class="cartelera__link"
            href={proyecto.data.vercel}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver ${proyecto.data.titulo} en Vercel`}
          />
          {/* Botón de GitHub: va arriba de todo, así el clic NO cae en el link de Vercel. */}
          <a
            class="cartelera__github"
            href={proyecto.data.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver el código de ${proyecto.data.titulo} en GitHub`}
            title="Ver el código en GitHub"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              />
            </svg>
          </a>
        </div>
      )
    }
  </div>
</article>

<style>
  .cartelera {
    position: absolute;
    /*
     * La base se planta en la línea de suelo de las CARTELERAS
     * (ESCENA.sueloCarteleras = 0.86, publicada como
     * --suelo-carteleras): la punta del poste toca la vereda donde ella
     * la dibujó. Es distinta de la de la chica (0.90): ella camina por
     * delante, más abajo, y no pisa nunca sobre un cartel.
     * Los números de posición salen de config.js vía escenario.js. Los
     * valores de respaldo son sólo para que el recuadro siga siendo
     * razonable antes de que corra el script.
     */
    bottom: calc((1 - var(--suelo-carteleras, 0.86)) * 100%);
    /*
     * OJO: el * 1px final no es decorativo. calc() sólo acepta
     * "longitud × número"; número × número da inválido y el left/width
     * entero se cae a auto (el cartel quedaba con ancho 0 y Mica no veía
     * NUNCA las carteleras). Multiplicar por 1px convierte el resultado
     * en longitud y el calc' es válido. Mismo truco que usa
     * Escenario.astro para la altura de los objetos.
     */
    left: calc(
      (var(--cartelera-margen, 1000) + var(--indice) * var(--cartelera-separacion, 633)) *
        var(--escala, 1) * 1px
    );
    width: calc(var(--cartelera-ancho, 359) * var(--escala, 1) * 1px);
    transition:
      opacity var(--duracion-aparecer, 0.6s) var(--curva-aparecer, ease-out),
      transform var(--duracion-aparecer, 0.6s) var(--curva-aparecer, ease-out);
  }

  /*
   * Las carteleras arrancan escondidas Y fuera de lugar. Escondidas desde
   * el CSS inicial (no sólo cuando el motor ya corrió) a propósito: el
   * HTML se pinta antes de que cargue el script, y eso era lo que Mica
   * veía como "aparecen un rato al recregar y después desaparecen".
   *
   * El motor las da vuelta una por una con `data-visible`; el
   * pointer-events: none es necesario sin eso, el hover de una cartelera
   * escondida cambiaría la pose de la chica a "mira" hacia algo que no se
   * ve. El fallback sin JavaScript vive en un <noscript> al final del
   * archivo: si estuviera acá, se aplicaría TAMBIÉN antes de que el
   * motor arranque y volvería el flash.
   */
  .cartelera {
    opacity: 0;
    transform: translateY(24px);
    pointer-events: none;
  }

  html[data-motor='riel'] .cartelera[data-visible='true'] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .cartelera__cartel {
    position: relative;
    width: 100%;
    /*
     * Proporción del dibujo de Mica: CartelVerde.svg mide 8606 × 13382.
     * (Antes decía 702 × 1088, que era del SVG anterior: la proporción
     * casi no cambia, 0.6431 contra 0.6452, pero el número exacto evita
     * que el afiche quede medio pixel desfasado.)
     */
    aspect-ratio: 8606 / 13382;
    /*
     * Con esto el cartel pasa a ser un "contenedor de consulta": las
     * medidas del botón de GitHub se calculan con cqw (unidades
     * relativas al ANCHO de este cartel). Así el botón se ve igual de
     * proportionado esté el cartel a escala 0.5 (celular) o 1.2
     * (pantalla grande), como si fuera parte del dibujo y no un widget
     * de la interfaz.
     */
    container-type: inline-size;
    /*
     * Sin sombra ni marco de CSS (pedido de Mica, 8/10): cualquier halo
     * rectangular queda como un recuadro alrededor del dibujo en vez de
     * ceñirse a su forma. Lo que "prende" la activa es sólo el scale.
     */
    transition: transform var(--duracion-prendido) var(--curva-prendido);
  }

  /* El arte de Mica ocupa todo el cartel. */
  .cartelera__arte {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /*
   * El hueco del cartel: el rectángulo que el marco verde deja libre.
   * Las medidas salen de config.js (CARTEL.hueco), que es el único lugar
   * donde hay que tocarlas si Mica cambia el dibujo:
   *   hueco: x 590..7996   y 2580..8011  (viewBox 8606 × 13382)
   *   left 6.86%   top 19.28%   width 86.05%   height 40.58%
   *
   * Las medidas del afiche negro (CARTEL.afiche: 40.33% / 1.57% / 20% /
   * 17.39%) NO sirven acá: ese rectángulo es opaco, es la ilustración de
   * Mica. El hueco que aloja la preview es el del centro.
   *
   * El fondo es el color del afiche (#0b100a) para que, mientras carga
   * la imagen, se vea el cartel en vez de un agujero blanco.
   */
  .cartelera__preview {
    position: absolute;
    left: var(--hueco-left);
    top: var(--hueco-top);
    width: var(--hueco-width);
    height: var(--hueco-height);
    overflow: hidden;
    background: #0b100a;
  }

  /*
   * La captura entra "deWa" al hueco: se recorta por los lados para
   * llenar el panel sin deformarse (object-fit: cover) y pegada al
   * borde superior, que es donde está el header de cada web.
   */
  .cartelera__preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  /* El link principal: cubre toda la preview y lleva a Vercel. */
  .cartelera__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /*
   * El botón de GitHub, en la esquina inferior derecha. Va con z-index
   * más alto que el link principal: así el clic lo toma a él y NO
   * dispara el link de Vercel. (Por eso los dos son <a> hermanos y no
   * uno dentro del otro: en HTML no se puede anidar un <a> en otro <a>.)
   */
  .cartelera__github {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    width: max(8cqw, 26px);
    height: max(8cqw, 26px);
    background: #181717;
    color: #fff;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.45);
    transition:
      transform var(--duracion-prendido) var(--curva-prendido),
      background var(--duracion-prendido) var(--curva-prendido);
  }

  .cartelera__github svg {
    width: 62%;
    height: 62%;
    display: block;
  }

  .cartelera__github:hover,
  .cartelera__github:focus-visible {
    background: #303030;
    transform: scale(1.08);
  }

  /* La cartelera activa se "prende": crece apenas y se levanta. Sin marco. */
  .cartelera[data-activa='true'] .cartelera__cartel {
    transform: scale(1.04) translateY(-10px);
  }

  /*
   * Menos movimiento: la cartelera aparece igual (el motor sigue marcando
   * data-visible), pero sin fundido ni desplazamiento.
   */
  @media (prefers-reduced-motion: reduce) {
    html[data-motor='riel'] .cartelera {
      transition: none;
    }
  }
</style>

<!--
  Fallback sin JavaScript. Va en <noscript> con style is:inline (crudo,
  sin scope de Astro) porque sólo tiene que aplicar cuando NO hay JS:
  si el navegador corre scripts, este contenido ni se parsea y las
  carteleras siguen ocultas hasta que el motor las revele — así no hay
  flash de carteleras sueltas al cargar. Sin JS, en cambio, dejan de
  estar posicionadas en el mundo y se apilan legibles.
-->
<noscript>
  <style is:inline>
    html:not([data-motor='riel']) .cartelera {
      position: static;
      width: min(320px, 78vw);
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  </style>
</noscript>
