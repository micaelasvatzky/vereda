---
/*
 * Cartelera — placeholder de la Fase 1.
 *
 * En esta fase sólo está el marco verde y el afiche negro, para poder medir
 * el motor del escenario (dónde caen, cuál queda activa). El contenido real,
 * el `<dialog>` y el afiche tipográfico entran en la Fase 2.
 *
 * PLACEHOLDER Fase 1: el marco verde es un rectángulo con sombra, NO la forma
 * del cartel icónico de Buenos Aires. Falta la foto de referencia de Mica.
 */

interface Props {
  indice: number;
}

const { indice } = Astro.props;
---

<article
  class="cartelera"
  data-cartelera
  data-indice={indice}
  data-activa="false"
  style={`--indice: ${indice};`}
>
  <div class="cartelera__marco">
    <div class="cartelera__afiche">
      <span class="todo-mica">TODO(Mica): #{indice + 1}</span>
    </div>
  </div>
  <div class="cartelera__poste" aria-hidden="true"></div>
</article>

<style>
  .cartelera {
    position: absolute;
    bottom: 0;
    /*
     * La posición sale de las variables que publica escenario.js desde
     * config.js. Los valores de respaldo son sólo para que el recuadro siga
     * siendo razonable antes de que corra el script.
     */
    left: calc(
      (var(--cartelera-margen, 1000) + var(--indice) * var(--cartelera-separacion, 1400)) *
        var(--escala, 1)
    );
    width: calc(var(--cartelera-ancho, 520) * var(--escala, 1));
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Sin JavaScript las carteleras dejan de estar posicionadas en el mundo. */
  html:not([data-motor='riel']) .cartelera {
    position: static;
    width: min(320px, 78vw);
  }

  .cartelera__marco {
    width: 100%;
    aspect-ratio: 4 / 5;
    background: var(--verde-cartelera);
    border: 6px solid var(--verde-cartelera-oscuro);
    border-radius: 10px;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.35);
    padding: 22px;
    transition:
      transform var(--duracion-prendido) var(--curva-prendido),
      box-shadow var(--duracion-prendido) var(--curva-prendido);
  }

  .cartelera__afiche {
    width: 100%;
    height: 100%;
    background: var(--afiche-fondo);
    color: var(--afiche-texto);
    display: grid;
    place-items: center;
    padding: 1rem;
    text-align: center;
  }

  .cartelera__poste {
    width: 14px;
    height: calc(180 * var(--escala));
    background: var(--verde-cartelera-oscuro);
  }

  /* La cartelera activa se "prende": crece apenas y levanta sombra. */
  .cartelera[data-activa='true'] .cartelera__marco {
    transform: scale(1.04) translateY(-10px);
    box-shadow:
      0 24px 60px rgb(0 0 0 / 0.5),
      0 0 0 8px rgb(255 255 255 / 0.12);
  }
</style>