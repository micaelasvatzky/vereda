---
import { CIUDAD } from '../config.js';
---

<aside class="clima-ciudad" data-clima data-estado="cargando" aria-label="Cielo de Buenos Aires">
  <a href="/creditos/" title="Fuente de los datos del clima">
    <span class="clima-ciudad__nombre">{CIUDAD.nombre}</span>
    <p data-clima-texto role="status">Consultando el cielo…</p>
  </a>
</aside>
<noscript><style is:inline>.clima-ciudad { display: none; }</style></noscript>

<style>
  .clima-ciudad {
    position: fixed;
    top: var(--bienvenida-margen);
    right: var(--bienvenida-margen);
    z-index: 10;
    max-width: var(--clima-ancho);
    text-align: left;
    color: var(--rotulo-texto);
    font-family: var(--fuente-bienvenida);
    font-size: var(--clima-tamano);
    line-height: 1.4;
    transition: color var(--duracion-cielo) var(--curva-cielo);
  }
  p { margin: 0; }
  a {
    display: block;
    background: var(--verde-cartelera-oscuro);
    padding: var(--clima-rotulo-espacio);
    border-radius: var(--clima-rotulo-radio);
    border: 1px solid currentColor;
    outline: 2px solid var(--verde-cartelera-oscuro);
    color: inherit;
    text-decoration: none;
    text-underline-offset: 0.15em;
  }
  a:hover, a:focus-visible { text-decoration: underline; }
  .clima-ciudad__nombre {
    display: block;
    margin-bottom: var(--clima-rotulo-separacion);
    font-family: var(--fuente-titulo);
    font-size: var(--clima-ciudad-tamano);
    letter-spacing: var(--clima-rotulo-interletra);
    text-transform: uppercase;
  }
  @media (max-width: 767px) {
    .clima-ciudad {
      top: var(--clima-mobile-arriba);
      left: var(--bienvenida-margen);
      right: auto;
      max-width: calc(100% - 2 * var(--bienvenida-margen));
      text-align: left;
    }
  }
</style>
