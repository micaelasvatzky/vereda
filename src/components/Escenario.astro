---
import { getCollection } from 'astro:content';
import { ESCENA, RUTAS_CAPAS, STICKERS, OBJETOS } from '../config.js';
import Caminante from './Caminante.astro';
import Cartelera from './Cartelera.astro';

/*
 * Escenario — el mundo por el que camina la chica.
 *
 * Estructura, de atrás hacia adelante:
 *   cielo        → color plano de la Escena de Mica (lo cambia cielo.js en la Fase 4)
 *   capa lejana  → el obelisco, se mueve poco (parallax lento)
 *   capa media   → el cartel de calles + la franja de vereda de atrás
 *   capa vereda  → la franja de vereda de adelante, se mueve a la velocidad
 *                  del mundo. Acá viven las carteleras, porque es el plano
 *                  donde están.
 *   caminante    → la chica, fija en pantalla
 *
 * Los objetos (obelisco, cartel de calles) salen de config.js con la posición
 * que tienen en la Escena de Mica; el motor los acomoda en su capa.
 *
 * El motor vive en src/scripts/escenario.js. Este componente sólo pone las
 * piezas y le pasa los números que necesita.
 *
 * FASE 2: las carteleras ya no son de prueba. Salen de la colección de
 * proyectos (src/content/proyectos/*.md), ordenadas por el campo `orden`.
 * Para agregar o sacar un proyecto se agrega o saca un `.md`; ni este
 * archivo ni el motor se tocan.
 */

const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);

/** Objetos decorativos que viven dentro de una capa. */
const objetosDe = (capaId) => OBJETOS.filter((o) => o.capa === capaId);

/** La franja de vereda de Mica es la misma imagen en la capa media y en la vereda. */
const franjaVereda = `url(${RUTAS_CAPAS.vereda})`;
---

<div class="riel" data-riel>
  <div class="escenario" data-escenario data-posicion="inicio" style={`--fondo-vereda: ${franjaVereda}`}>
    <div class="escenario__cielo" data-cielo></div>

    <div class="escenario__capa escenario__capa--lejana" data-capa={ESCENA.capas[0].id}>
      {
        objetosDe(ESCENA.capas[0].id).map((o) => (
          <img
            class="escenario__objeto"
            data-objeto
            data-x={o.x}
            src={o.src}
            alt=""
            aria-hidden="true"
            style={`--objeto-alto:${o.alto}; --objeto-base:${o.base};`}
          />
        ))
      }
    </div>

    <div class="escenario__capa escenario__capa--media" data-capa={ESCENA.capas[1].id}>
      {
        objetosDe(ESCENA.capas[1].id).map((o) => (
          <img
            class="escenario__objeto"
            data-objeto
            data-x={o.x}
            src={o.src}
            alt=""
            aria-hidden="true"
            style={`--objeto-alto:${o.alto}; --objeto-base:${o.base};`}
          />
        ))
      }
    </div>

    <div
      class="escenario__capa escenario__capa--vereda escenario__mundo"
      data-capa={ESCENA.capas[2].id}
      data-mundo
    >
      {
        STICKERS.map((st) => (
          <img
            class="escenario__sticker"
            src={st.src}
            alt=""
            aria-hidden="true"
            style={`left:${st.x * 100}%; top:${st.y * 100}%; rotate:${st.rotacion}deg; scale:${st.escala};`}
          />
        ))
      }
      {proyectos.map((proyecto, i) => <Cartelera indice={i} proyecto={proyecto} />)}
    </div>

    <Caminante />

    {
      /* Indicador de debug. Sólo en desarrollo: muestra los números del motor. */
      import.meta.env.DEV && (
        <div class="escenario__debug" data-debug>
          <p>
            p: <span data-debug-p>0</span> · escala: <span data-debug-escala>1</span>
          </p>
          <p>
            recorrido: <span data-debug-recorrido>0</span>px · activa:{' '}
            <span data-debug-activa>ninguna</span>
          </p>
        </div>
      )
    }

    <p class="escenario__sin-js">
      Sin JavaScript el recorrido no camina, pero las carteleras se leen: se las puede
      desplazar con la barra de scroll horizontal.
    </p>
  </div>
</div>

<style>
  /*
   * El "riel" es la página alta. Es lo único que crece con el recorrido; el
   * escenario queda fijo mientras el riel se desplaza.
   */
  .riel {
    position: relative;
    height: 100dvh;
  }

  .escenario {
    position: sticky;
    top: 0;
    height: 100dvh;
    overflow: hidden;
  }

  .escenario__cielo {
    position: absolute;
    inset: 0;
    background: var(--cielo-dia);
    transition: background var(--duracion-cielo) var(--curva-cielo);
  }

  /*
   * Las capas se mueven con translate3d, que corre en la GPU: por eso el
   * `will-change`. El ancho extra es lo que viaja al hacer scroll.
   */
  .escenario__capa {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    will-change: transform;
    background-repeat: repeat-x;
  }

  /*
   * Las dos franjas de vereda son el mismo dibujo de Mica, a distinta
   * altura: la de atrás arranca en y 75.9% y la delantera en y 82.5%
   * (toca el borde inferior). El dibujo mide 11.16 de ancho por 1 de alto,
   * así que con el alto fijo en 17.5% del escenario cada mosaqueo mide lo
   * que mide su Escena (2110 px de referencia): se repite igual que ella
   * lo dibujó.
   *
   * background-position va en % del espacio libre (altura de la capa menos
   * alto de la imagen), así que:
   *   atrás:    (100 - 17.5) × 92% = 75.9%
   *   adelante: 100%               = 82.5%
   *
   * La capa lejana no lleva franja ni fondo: ahí se ve el cielo.
   */
  .escenario__capa--media {
    background-image: var(--fondo-vereda);
    background-size: auto 17.5%;
    background-position: 0 92%;
  }

  .escenario__capa--vereda {
    background-image: var(--fondo-vereda);
    background-size: auto 17.5%;
    background-position: 0 100%;
  }

  /*
   * Objetos decorativos (obelisco, cartel de calles). La posición
   * horizontal la calcula escenario.js con la fórmula del parallax; acá
   * sólo se les da altura y línea de apoyo, en px de referencia.
   */
  .escenario__objeto {
    position: absolute;
    /*
     * Arranca fuera de pantalla: escenario.js lo ubica apenas arranca el
     * motor. Así no aparece pegado al borde izquierdo en la primera
     * pintada (el script es un módulo y corre después del HTML).
     */
    left: -9999px;
    bottom: calc((1 - var(--objeto-base)) * 100%);
    height: calc(var(--objeto-alto) * 1px * var(--escala, 1));
    width: auto;
    pointer-events: none;
    user-select: none;
  }

  .escenario__mundo {
    /* Altura de referencia: el layer se estira al alto de la pantalla. */
    height: 100%;
  }

  .escenario__sticker {
    position: absolute;
    width: calc(70px * var(--escala));
    opacity: 0.9;
    pointer-events: none;
  }

  .escenario__debug {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    background: rgb(0 0 0 / 0.7);
    color: #fff;
    font-family: ui-monospace, monospace;
    font-size: 12px;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    line-height: 1.5;
    pointer-events: none;
  }

  .escenario__debug p {
    margin: 0;
  }

  .escenario__sin-js {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    background: #ffe066;
    color: #1a1a1a;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    font-size: 0.9rem;
  }

  /*
   * --- Sin JavaScript ---------------------------------------------------
   * El motor pone `data-motor="riel"` en el `<html>` apenas arranca. Si no está,
   * es que el script no corrió: en ese caso el escenario deja de ser fijo y las
   * carteleras pasan a ser una fila que se puede desplazar a mano. Se leen
   * todas, que es lo que importa: el sitio no queda en blanco.
   */
  html:not([data-motor='riel']) .riel {
    height: auto;
  }

  html:not([data-motor='riel']) .escenario {
    position: static;
    height: auto;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 4rem 1.5rem 2rem;
    background: var(--fondo);
  }

  html:not([data-motor='riel']) .escenario__cielo,
  html:not([data-motor='riel']) .escenario__capa:not([data-mundo]),
  /* La chica se renderiza en Caminante.astro: Astro no deja que un selector
     scoped mire adentro de otro componente, así que esa parte va con :global(). */
  html:not([data-motor='riel']) :global(.caminante),
  html:not([data-motor='riel']) .escenario__sticker {
    display: none;
  }

  html:not([data-motor='riel']) .escenario__mundo {
    position: static;
    height: auto;
    width: auto;
    background-image: none;
    display: flex;
    align-items: flex-end;
    gap: 2rem;
  }

  /* Pistas de posición. Se muestran según data-posicion, más adelante en la Fase 3. */
  [data-posicion] .pista {
    display: none;
  }
</style>